# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments (rebuild per machine: pip install -r software/requirements.txt)
# The glob matters: a venv named .venv-cad slipped past a bare `.venv/`
# and put 177 MB of macOS-ARM wheels into the history, which then got
# pulled onto the Pi where they cannot even run.
.venv*/
venv*/

# macOS
.DS_Store

# Editor / local tool settings
.vscode/
.idea/
.claude/settings.local.json__pycache__/
*.pyc
.DS_Store

# IMU calibration is per-robot, written by utils/calibrate_imu.py
software/imu_calibration.json

# agentix credentials. The real file lives at /etc/crabora/agentix.env on
# the robot (root-owned, 0600); these patterns only catch a stray copy.
*.env
agentix.env
